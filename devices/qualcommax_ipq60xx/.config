CONFIG_TARGET_qualcommax=y
CONFIG_TARGET_qualcommax_ipq60xx=y
CONFIG_TARGET_qualcommax_ipq60xx_DEVICE_jdcloud_re-ss-01=y
CONFIG_KERNEL_CC_OPTIMIZE_FOR_SIZE=y

# ===== 只编这一台：关掉全 profile =====
# CONFIG_TARGET_MULTI_PROFILE is not set
# CONFIG_TARGET_ALL_PROFILES is not set

# ==================================================
# LuCI 应用（保留）
# ==================================================
CONFIG_PACKAGE_luci-app-advancedplus=y
CONFIG_PACKAGE_luci-app-cpufreq=y
CONFIG_PACKAGE_luci-app-firewall=y
CONFIG_PACKAGE_luci-app-footstrap-files=y
CONFIG_PACKAGE_luci-app-oui=y
CONFIG_PACKAGE_luci-app-package-manager=y
CONFIG_PACKAGE_luci-app-partexp=y
CONFIG_PACKAGE_luci-app-sqm=y
CONFIG_PACKAGE_luci-app-store=y
CONFIG_PACKAGE_luci-app-syscontrol=y
CONFIG_PACKAGE_luci-app-sysctl=y
CONFIG_PACKAGE_luci-app-timedreboot=y
CONFIG_PACKAGE_luci-app-timewol=y
CONFIG_PACKAGE_luci-app-wizard=y
CONFIG_PACKAGE_luci-app-wolultra=y

# ===== 精简：移除 =====
# 定时重启保留 timedreboot（定时重启+定时关机+循环），移除 autoreboot
# CONFIG_PACKAGE_luci-app-autoreboot is not set
# 宽带提速小助手
# CONFIG_PACKAGE_luci-app-broadbandacc is not set
# ADG / cloudflared 不编译，后续按需 opkg 安装
# CONFIG_PACKAGE_luci-app-adguardhome is not set
# CONFIG_PACKAGE_adguardhome is not set
# CONFIG_PACKAGE_cloudflared is not set

# ==================================================
# 主题 / Web
# ==================================================
CONFIG_PACKAGE_luci-theme-aurora=y
CONFIG_PACKAGE_luci-theme-bootstrap=y
CONFIG_PACKAGE_luci-nginx=y
CONFIG_PACKAGE_nginx-ssl=y
CONFIG_PACKAGE_xz-utils=y

# ==================================================
# 局域网工具：WOL 唤醒（X8s 接入 10.1 自动唤醒 PC）
# wol 默认端口是 40000，网卡只认 9，脚本里必须显式 -p 9
# ==================================================
CONFIG_PACKAGE_wol=y
CONFIG_PACKAGE_etherwake=y
CONFIG_PACKAGE_tcpdump=y
CONFIG_PACKAGE_mmc-utils=y

# ==================================================
# USB 网卡（E5 gadget 走 CDC-NCM，RNDIS 备用）
# 刷机后 USB 上网的命脉，必须编进固件
# ==================================================
CONFIG_PACKAGE_kmod-usb-net=y
CONFIG_PACKAGE_kmod-usb-net-cdc-ncm=y
CONFIG_PACKAGE_kmod-usb-net-cdc-ether=y
CONFIG_PACKAGE_kmod-usb-net-rndis=y
CONFIG_PACKAGE_kmod-mii=y
CONFIG_PACKAGE_kmod-usb-common=y
CONFIG_PACKAGE_kmod-usb-core=y
CONFIG_PACKAGE_kmod-usb-xhci-hcd=y
CONFIG_PACKAGE_kmod-usb-dwc3=y
CONFIG_PACKAGE_kmod-usb-dwc3-qcom=y
CONFIG_PACKAGE_kmod-usb-roles=y
CONFIG_PACKAGE_kmod-usb3=y

# ==================================================
# 存储 / 文件系统
# ==================================================
CONFIG_PACKAGE_kmod-usb-storage=y
CONFIG_PACKAGE_kmod-usb-storage-extras=y
CONFIG_PACKAGE_kmod-usb-storage-uas=y
CONFIG_PACKAGE_kmod-scsi-core=y
CONFIG_PACKAGE_kmod-fs-ext4=y
CONFIG_PACKAGE_kmod-fs-vfat=y
CONFIG_PACKAGE_kmod-fs-exfat=y
CONFIG_PACKAGE_kmod-fs-ntfs3=y
CONFIG_PACKAGE_kmod-fs-f2fs=y
CONFIG_PACKAGE_kmod-fs-btrfs=y

# ==================================================
# NSS 硬件加速（全家桶）
# kmod-tls 是 bonding 前置依赖，缺了整条加速链全废
# ==================================================
CONFIG_PACKAGE_kmod-tls=y
CONFIG_PACKAGE_kmod-bonding=y
CONFIG_PACKAGE_kmod-qca-ssdk=y
CONFIG_PACKAGE_kmod-qca-nss-dp=y
CONFIG_PACKAGE_kmod-qca-nss-crypto=y
CONFIG_PACKAGE_kmod-qca-nss-drv=y
CONFIG_PACKAGE_kmod-qca-nss-drv-bridge-mgr=y
CONFIG_PACKAGE_kmod-qca-nss-drv-eogremgr=y
CONFIG_PACKAGE_kmod-qca-nss-drv-gre=y
CONFIG_PACKAGE_kmod-qca-nss-drv-igs=y
CONFIG_PACKAGE_kmod-qca-nss-drv-l2tpv2=y
CONFIG_PACKAGE_kmod-qca-nss-drv-lag-mgr=y
CONFIG_PACKAGE_kmod-qca-nss-drv-map-t=y
CONFIG_PACKAGE_kmod-qca-nss-drv-match=y
CONFIG_PACKAGE_kmod-qca-nss-drv-mirror=y
CONFIG_PACKAGE_kmod-qca-nss-drv-netlink=y
CONFIG_PACKAGE_kmod-qca-nss-drv-pppoe=y
CONFIG_PACKAGE_kmod-qca-nss-drv-pptp=y
CONFIG_PACKAGE_kmod-qca-nss-drv-qdisc=y
CONFIG_PACKAGE_kmod-qca-nss-drv-tun6rd=y
CONFIG_PACKAGE_kmod-qca-nss-drv-tunipip6=y
CONFIG_PACKAGE_kmod-qca-nss-drv-vlan-mgr=y
CONFIG_PACKAGE_kmod-qca-nss-drv-vxlanmgr=y
CONFIG_PACKAGE_kmod-qca-nss-drv-wifi-meshmgr=y
CONFIG_PACKAGE_kmod-qca-nss-ecm=y
CONFIG_PACKAGE_kmod-nss-ifb=y
CONFIG_PACKAGE_nss-firmware=y
CONFIG_PACKAGE_nss-firmware-ipq60xx=y
CONFIG_PACKAGE_nss-eip-firmware=y
CONFIG_PACKAGE_kmod-nft-fullcone=y

# ==================================================
# SQM 队列管理（NSS 版）
# sqm-scripts-nss 依赖 sqm-scripts + nss-drv-qdisc + nss-drv-igs
# ==================================================
CONFIG_PACKAGE_sqm-scripts=y
CONFIG_PACKAGE_sqm-scripts-nss=y

# ==================================================
# 网络基础
# ==================================================
CONFIG_PACKAGE_dnsmasq-full=y
CONFIG_PACKAGE_firewall4=y
CONFIG_PACKAGE_nftables-json=y
CONFIG_PACKAGE_odhcpd-ipv6only=y
CONFIG_PACKAGE_ppp=y
CONFIG_PACKAGE_ppp-mod-pppoe=y
CONFIG_PACKAGE_wpad-mbedtls=y
CONFIG_PACKAGE_etherwake=y
